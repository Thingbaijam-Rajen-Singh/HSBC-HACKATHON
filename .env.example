# Copy this file to .env and replace the placeholders.
# Never commit your real .env file.

# Server-only AI keys. Do NOT prefix these with VITE_.
GEMINI_API_KEY=replace_with_your_gemini_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key

# App/server settings
APP_URL=http://localhost:3000
PORT=3000

# Firebase Web App configuration for YOUR Firebase project.
# VITE_ values are included in the browser build. They are configuration, not server secrets.
VITE_FIREBASE_API_KEY=replace_with_your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: set this only when using a named Firestore database rather than the default database.
VITE_FIREBASE_DATABASE_ID=
